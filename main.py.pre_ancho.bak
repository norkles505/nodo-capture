AR = Qt.AlignRight | Qt.AlignVCenter

_FAMILY = None


def font_family():
    global _FAMILY
    if _FAMILY is None:
        _FAMILY = "Inter"
        fid = QFontDatabase.addApplicationFont(str(DATA / "Inter.ttf"))
        fams = QFontDatabase.applicationFontFamilies(fid) if fid != -1 else []
        if fams:
            _FAMILY = fams[0]
        print("Fuente:", _FAMILY, "(Inter.woff2 cargada)" if fams else "(no se pudo cargar Inter.woff2)")
    return _FAMILY


def make_font():
    f = QFont(font_family())
    f.setFamilies([font_family(), "Inter", "Segoe UI", "Arial"])
    f.setPixelSize(11)
    f.setHintingPreference(QFont.PreferNoHinting)
    return f


